{
  "name": "sprite-gen-mcp",
  "version": "1.0.0",
  "description": "Sprite Sheet Generator MCP Server — runs standalone, no DSH required",
  "type": "module",
  "main": "server.js",
  "bin": {
    "sprite-gen-mcp": "server.js"
  },
  "scripts": {
    "start": "node server.js",
    "web": "node web/server.js",
    "test": "node test/test_all.js",
    "test:unit": "node test/test_all.js",
    "test:contract": "node test/contract_all.js",
    "test:direct": "node test/direct_call.js",
    "test:stability": "node --expose-gc test/stability.js",
    "test:mcp": "node test/mcp_handshake.js",
    "test:provider": "node test/provider_penetration.js",
    "test:video": "node test/video_real.js",
    "test:security": "node test/security_matrix.js",
    "test:concurrency": "node test/sharp_concurrency.js",
    "test:qc": "node test/qc_test.js",
    "test:regression": "node test/regression.js",
    "test:cover_prop": "node test/cover_prop_test.js",
    "test:phased": "node test/phased_workflow_test.js",
    "test:phased:v2": "node test/phased_workflow_v2_test.js",
    "test:godot-resolution": "node test/godot_resolution_test.js",
    "test:e2e": "node test/e2e_cover_prop.js",
    "test:audit": "node test/audit_test.js",
    "test:regenerate": "node test/regenerate_test.js",
    "test:godot_gate": "node test/godot_gate_test.js",
    "test:failure_injection": "node test/failure_injection_test.js",
    "test:artifact_cleanup": "node test/artifact_cleanup_test.js",
    "test:all": "node test/test_all.js && node test/contract_all.js && node test/direct_call.js && node test/mcp_handshake.js && node test/provider_penetration.js && node test/video_real.js && node test/security_matrix.js && node test/sharp_concurrency.js",
    "test:commercial": "node test/commercial.js",
    "bench": "node --expose-gc bench/bench.js",
    "bench:single": "node --expose-gc bench/bench.js --scenario single",
    "bench:concurrency": "node --expose-gc bench/bench.js --scenario concurrency",
    "bench:batch": "node --expose-gc bench/bench.js --scenario batch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "sharp": "^0.35.4"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
